libxcomposite-dev libxss libxmuu-dev libpam0g-dev pamtester
./configure --prefix=$HOME/libshare/xsecurelock \
--with-mpv=/usr/bin/mpv \
--with-xsync --with-xcomposite --with-xss \
--with-pam-service-name lightdm-greeter \
--bindir=$HOME/bin

pam-service-name in /etc/pam.d/
	common-auth
	xscreensaver
	or screensaver of choice

#!/bin/zsh
export XSECURELOCK_AUTH_BACKGROUND_COLOR=#000
export XSECURELOCK_AUTH_FOREGROUND_COLOR=#0A0 
export XSECURELOCK_AUTH_WARNING_COLOR=#A00 
export XSECURELOCK_DIM_ALPHA="0.5" 
export XSECURELOCK_DIM_COLOR=#333 
